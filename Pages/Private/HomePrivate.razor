@page "/authorized"
@using System.Timers
@using HowClient.Configuration
@using HowClient.Infrastructure.DTO.Models
@using HowClient.Infrastructure.DTO.Private.Event
@using HowClient.Infrastructure.Enums
@using HowClient.Infrastructure.Helpers
@using HowClient.Services.InternalNotification
@using HowClient.Services.Private.Event
@using Microsoft.AspNetCore.Components.Authorization
@using Components
@using HowClient.Common.Routing

@inject IEventPrivateService EventPrivateService
@inject AppConfigurations AppConfigurations
@inject NavigationManager NavigationManager
@inject InternalNotificationService InternalNotificationService
@implements IDisposable

<PageTitle>Explore Feed — How Long Ago</PageTitle>

<div class="how-page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
    <div>
        <h1 class="h3 fw-bold">Welcome back, @(string.IsNullOrWhiteSpace(UserName) ? "Explorer" : UserName)!</h1>
        <p class="subtitle">Discover active community events, react to milestones, and bookmark events to your Saved list.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <button class="btn btn-light fw-semibold rounded-pill px-3" @onclick="() => NavigationManager.NavigateTo(Rout.Dashboard.MainDashboard)">
            <Icon Name="IconName.Grid1X2Fill" /> Go to My Dashboard
        </button>
    </div>
</div>

<div class="how-toolbar">
    <div class="how-search-box">
        <i class="bi bi-search"></i>
        <InputText class="form-control" placeholder="Search community events..." @bind-Value="_searchQuery" />
    </div>
    <button class="btn btn-primary d-flex align-items-center gap-2" @onclick="ReloadEvents" disabled="@_isLoading">
        <Icon Name="IconName.Search" /> Search
    </button>
    @if (!string.IsNullOrWhiteSpace(_searchQuery))
    {
        <button class="btn btn-outline-secondary" @onclick="ClearSearch" disabled="@_isLoading">
            Clear
        </button>
    }
</div>

@if (_isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary mb-2" role="status"></div>
        <p class="text-muted mb-0">Loading feed...</p>
    </div>
}
else if (_count > 0)
{
    <div class="how-events-grid">
        @foreach (var item in _eventsToDisplay)
        {
            <div class="how-event-card">
                <div class="how-card-cover-wrap">
                    <img src="@item.Image.ThumbnailHash" class="how-card-cover" alt="@item.Name" />
                    <div class="how-card-badges">
                        <span class="how-pill-badge how-pill-public">
                            <Icon Name="IconName.Globe" /> Public
                        </span>
                        <button type="button"
                                class="how-reaction-btn @(item.IsSavedByUser ? "active-save" : "")"
                                @onclick="async () => await ChangeSavedEventState(item)"
                                disabled="@item.ButtonSavedDisable"
                                title="@(item.IsSavedByUser ? "Remove from Saved" : "Save Event")">
                            <Icon Name="@(item.IsSavedByUser ? IconName.BookmarkCheckFill : IconName.BookmarkPlus)" />
                            <span>@item.SavedCount</span>
                        </button>
                    </div>
                </div>

                <div class="how-card-body">
                    <h5 class="how-card-title" title="@item.Name">@item.Name</h5>

                    <div class="how-timer-box">
                        <div class="how-timer-label">Elapsed Time</div>
                        <div class="how-timer-value">@DurationFormatHelper.FormatHumanReadable(item.Duration)</div>
                    </div>

                    <div class="how-author-row">
                        <div class="how-author-info">
                            <img src="@item.UserInfo.Image.ThumbnailHash" class="how-avatar-sm" alt="Author" />
                            <div>
                                <div class="how-author-name">
                                    @(string.IsNullOrWhiteSpace($"{item.UserInfo.FirstName} {item.UserInfo.LastName}")
                                        ? "Community Member"
                                        : $"{item.UserInfo.FirstName} {item.UserInfo.LastName}")
                                </div>
                                <div class="how-created-date">Started @item.CreatedAt.ToString("MMM dd, yyyy HH:mm")</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="how-action-bar">
                    <div class="how-reactions">
                        <button type="button"
                                class="how-reaction-btn @(item.OwnLikeState == LikeState.Like ? "active-like" : "")"
                                @onclick="async () => await ChangeLikeEventState(item)"
                                disabled="@item.ButtonLikeDisable"
                                title="Like">
                            <Icon Name="IconName.HeartFill" /> @item.Likes
                        </button>
                        <button type="button"
                                class="how-reaction-btn @(item.OwnLikeState == LikeState.Dislike ? "active-dislike" : "")"
                                @onclick="async () => await ChangeDislikeEventState(item)"
                                disabled="@item.ButtonDislikeDisable"
                                title="Dislike">
                            <Icon Name="IconName.HandThumbsDownFill" /> @item.Dislikes
                        </button>
                    </div>
                    <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="() => NavigateToEventInfo(item.Id)">
                        Timeline <Icon Name="IconName.ArrowRight" />
                    </button>
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-center mt-3">
        <Pagination ActivePageNumber="@_currentPageNumber" TotalPages="@_totalPage" PageChanged="OnPageChangedAsync" Alignment="Alignment.Center" />
    </div>
}
else
{
    <div class="how-empty-state">
        <div class="how-empty-icon"><Icon Name="IconName.CalendarX" /></div>
        <h5 class="fw-bold">No matching events found</h5>
        <p class="text-muted mb-3">Try clearing your search filter or head over to your Dashboard to create a new event.</p>
        <div class="d-flex justify-content-center gap-2">
            <button class="btn btn-outline-secondary rounded-pill px-4" @onclick="ClearSearch">Reset Filter</button>
            <button class="btn btn-primary rounded-pill px-4" @onclick="() => NavigationManager.NavigateTo(Rout.Dashboard.MainDashboard)">Create Event</button>
        </div>
    </div>
}

@code {
    string UserName { get; set; }

    [CascadingParameter]
    Task<AuthenticationState> AuthenticationState { get; set; }

    [CascadingParameter(Name = "ErrorComponent")]
    protected IErrorComponent ErrorComponent { get; set; }

    private int _count = 0;
    private bool _isLoading = true;
    private List<EventItemPrivateModelDTO> _eventsToDisplay = new();
    private Dictionary<int, List<EventItemPrivateModelDTO>> _loadedEvents = new();

    private int _currentPageNumber = 1;
    private readonly int _pageSize = 6;
    private int _totalPage = 1;
    private string _searchQuery = string.Empty;

    private Timer _timer;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationState is not null)
        {
            var authState = await AuthenticationState;
            var user = authState?.User;

            if (user?.Identity is not null && user.Identity.IsAuthenticated)
            {
                UserName = user.Identity.Name;
            }
            else
            {
                NavigationManager.NavigateTo(Rout.Home.HomePublicPage);
                return;
            }
        }

        _timer = new Timer(1000);
        _timer.Elapsed += OnTimerElapsed;
        _timer.Start();

        InternalNotificationService.OnError += HandleError;

        await OnPageChangedAsync(_currentPageNumber);
    }

    private async void OnTimerElapsed(object sender, ElapsedEventArgs e)
    {
        foreach (var eventItem in _eventsToDisplay)
        {
            eventItem.Duration = DateTime.Now - eventItem.CreatedAt;
        }

        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        InternalNotificationService.OnError -= HandleError;
        if (_timer is not null)
        {
            _timer.Elapsed -= OnTimerElapsed;
            _timer.Stop();
            _timer.Dispose();
        }
    }

    private async Task ClearSearch()
    {
        _searchQuery = string.Empty;
        await ReloadEvents();
    }

    private async Task ReloadEvents()
    {
        _currentPageNumber = 1;
        _eventsToDisplay.Clear();
        _loadedEvents.Clear();
        await GetCurrentPage();
    }

    private async Task OnPageChangedAsync(int pageNumber)
    {
        _currentPageNumber = pageNumber;
        await GetCurrentPage();
    }

    private async Task GetCurrentPage()
    {
        _isLoading = true;
        StateHasChanged();

        if (_loadedEvents.TryGetValue(_currentPageNumber, out var events))
        {
            _eventsToDisplay = events;
        }
        else
        {
            if (_currentPageNumber > _totalPage || _currentPageNumber < 1)
            {
                _currentPageNumber = _totalPage == 0 ? 1 : _totalPage;
            }
            await LoadEvents();
            if (_loadedEvents.TryGetValue(_currentPageNumber, out var loaded))
            {
                _eventsToDisplay = loaded;
            }
        }

        _isLoading = false;
        StateHasChanged();
    }

    private async Task LoadEvents()
    {
        var result = await EventPrivateService.GetEventsPagination(
            new GetEventsPaginationPrivateRequestDTO
            {
                Page = _currentPageNumber,
                Size = _pageSize,
                Search = _searchQuery,
                Status = EventStatus.Active,
                Access = EventAccessType.Public
            });

        foreach (var eventItem in result.Events)
        {
            eventItem.Image.MainHash = ImagePathHelper.GetPath(AppConfigurations.BackendUrl, eventItem.Image.MainHash);
            eventItem.Image.ThumbnailHash = ImagePathHelper.GetPath(AppConfigurations.BackendUrl, eventItem.Image.ThumbnailHash);

            eventItem.UserInfo.Image.MainHash = ImagePathHelper.GetPath(AppConfigurations.BackendUrl, eventItem.UserInfo.Image.MainHash);
            eventItem.UserInfo.Image.ThumbnailHash = ImagePathHelper.GetPath(AppConfigurations.BackendUrl, eventItem.UserInfo.Image.ThumbnailHash);

            eventItem.Duration = DateTime.Now - eventItem.CreatedAt;
        }

        _count = result.Count;
        _totalPage = (int)Math.Ceiling((double)_count / _pageSize);

        _loadedEvents.TryAdd(_currentPageNumber, result.Events);
    }

    private async Task ChangeSavedEventState(EventItemPrivateModelDTO eventItem)
    {
        eventItem.ButtonSavedDisable = true;
        try
        {
            var oldValue = eventItem.IsSavedByUser;
            var success = eventItem.IsSavedByUser
                ? await EventPrivateService.DeleteEventFromSaved(eventItem.Id)
                : await EventPrivateService.AddEventToSaved(eventItem.Id);

            if (success)
            {
                eventItem.IsSavedByUser = !eventItem.IsSavedByUser;
                eventItem.SavedCount = oldValue ? --eventItem.SavedCount : ++eventItem.SavedCount;
            }
        }
        finally
        {
            eventItem.ButtonSavedDisable = false;
        }
    }

    private async Task ChangeLikeEventState(EventItemPrivateModelDTO eventItem)
    {
        eventItem.ButtonDislikeDisable = true;
        eventItem.ButtonLikeDisable = true;
        try
        {
            await UpdateLikeState(
                eventItem,
                eventItem.OwnLikeState == LikeState.Like ? LikeState.None : LikeState.Like);
        }
        finally
        {
            eventItem.ButtonDislikeDisable = false;
            eventItem.ButtonLikeDisable = false;
        }
    }

    private async Task ChangeDislikeEventState(EventItemPrivateModelDTO eventItem)
    {
        eventItem.ButtonDislikeDisable = true;
        eventItem.ButtonLikeDisable = true;
        try
        {
            await UpdateLikeState(
                eventItem,
                eventItem.OwnLikeState == LikeState.Dislike ? LikeState.None : LikeState.Dislike);
        }
        finally
        {
            eventItem.ButtonDislikeDisable = false;
            eventItem.ButtonLikeDisable = false;
        }
    }

    private async Task UpdateLikeState(EventItemPrivateModelDTO eventItem, LikeState state)
    {
        var oldState = eventItem.OwnLikeState;

        eventItem.OwnLikeState = await EventPrivateService.UpdateEventLikeState(eventItem.Id, state);

        if (oldState == eventItem.OwnLikeState)
        {
            return;
        }

        EventLikeDislikeHelper.CountLikeDislike(oldState, eventItem.OwnLikeState, out int likes, out int dislikes);

        eventItem.Likes += likes;
        eventItem.Dislikes += dislikes;
    }

    private void NavigateToEventInfo(int eventId)
    {
        NavigationManager.NavigateTo(Rout.Event.EventPrivatePage(eventId));
    }

    private void HandleError(string message)
    {
        ErrorComponent?.ShowError("Error!", message);
    }
}