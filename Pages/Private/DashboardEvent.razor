@page "/authorized/dashboard/event/{EventId:int:min(1)}/record"
@using System.Timers
@using HowClient.Common.Routing
@using HowClient.Components
@using HowClient.Components.Modals
@using HowClient.Configuration
@using HowClient.Infrastructure.DTO.Models
@using HowClient.Infrastructure.DTO.Private.Record
@using HowClient.Infrastructure.Enums
@using HowClient.Infrastructure.Helpers
@using HowClient.Services.InternalNotification
@using HowClient.Services.Private.Event
@using HowClient.Services.Private.Record
@using Microsoft.AspNetCore.Components.Authorization

@inject IRecordPrivateService RecordPrivateService
@inject IEventPrivateService EventPrivateService
@inject AppConfigurations AppConfigurations
@inject NavigationManager NavigationManager
@inject InternalNotificationService InternalNotificationService
@implements IDisposable

<PageTitle>Manage @(_event?.Name ?? "Event") — How Long Ago</PageTitle>

<Modal @ref="_createEventModal" Size="ModalSize.Large"></Modal>
<Modal @ref="_uploadImageModal" Size="ModalSize.Large"></Modal>
<Modal @ref="_recordModal" Size="ModalSize.Large"></Modal>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick="() => NavigationManager.NavigateTo(Rout.Dashboard.MainDashboard)">
        <Icon Name="IconName.ArrowLeft" /> Back to Dashboard
    </button>
    <div class="d-flex gap-2">
        <button class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="ReloadEventAndRecords">
            <Icon Name="IconName.ArrowClockwise" /> Refresh
        </button>
        <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="ShowCreateRecordModal">
            <Icon Name="IconName.PlusLg" /> Add Occurrence Record
        </button>
    </div>
</div>

@if (_event is not null)
{
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden mb-4">
        <div class="row g-0">
            <div class="col-md-5 bg-light d-flex flex-column align-items-center justify-content-center p-3 position-relative">
                <img src="@_event.Image.ThumbnailHash" class="rounded-3 img-fluid shadow-sm mb-3" alt="@_event.Name" style="max-height: 230px; object-fit: cover;" />
                <button type="button" class="btn btn-sm btn-dark rounded-pill px-3" @onclick="ShowUploadImageModal">
                    <Icon Name="IconName.CameraFill" /> Change Event Cover
                </button>
            </div>

            <div class="col-md-7 p-4 d-flex flex-column justify-content-between">
                <div>
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <div class="d-flex gap-1">
                            <span class="how-pill-badge @(_event.Access == EventAccessType.Public ? "how-pill-public" : "how-pill-private")">
                                <Icon Name="@(_event.Access == EventAccessType.Public ? IconName.Globe : IconName.LockFill)" />
                                @_event.Access
                            </span>
                            <span class="how-pill-badge @(_event.Status == EventStatus.Active ? "how-pill-active" : "how-pill-inactive")">
                                @_event.Status
                            </span>
                        </div>
                        <div class="d-flex gap-1">
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick="ShowUpdateEventModal">
                                <Icon Name="IconName.PencilFill" /> Rename
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" @onclick="DeleteEvent">
                                <Icon Name="IconName.TrashFill" /> Delete
                            </button>
                        </div>
                    </div>

                    <h2 class="h4 fw-bold mb-3">@_event.Name</h2>

                    <div class="how-timer-box mb-3">
                        <div class="how-timer-label">Live Elapsed Time Since Event</div>
                        <div class="how-timer-value fs-3">@DurationFormatHelper.FormatHumanReadable(_event.Duration)</div>
                    </div>

                    <div class="d-flex flex-wrap gap-4 bg-light rounded-3 px-3 py-2 border mb-3">
                        <Switch @onclick="async () => await OnAccessToggleChanged()"
                                Value="_event.AccessToggle"
                                ValueExpression="() => _event.AccessToggle"
                                Label="Public Visibility" />
                        <Switch @onclick="async () => await OnStatusToggleChanged()"
                                Value="_event.StatusToggle"
                                ValueExpression="() => _event.StatusToggle"
                                Label="Active Status" />
                    </div>
                </div>

                <div class="d-flex flex-wrap justify-content-between align-items-center pt-3 border-top gap-2">
                    <div class="how-author-info">
                        <img src="@_event.UserInfo.Image.ThumbnailHash" class="how-avatar-sm" alt="Author" />
                        <div>
                            <div class="how-author-name">
                                @(string.IsNullOrWhiteSpace($"{_event.UserInfo.FirstName} {_event.UserInfo.LastName}")
                                    ? "Owner"
                                    : $"{_event.UserInfo.FirstName} {_event.UserInfo.LastName}")
                            </div>
                            <div class="how-created-date">Created @DurationFormatHelper.FormatLocalDateTime(_event.CreatedAt)</div>
                        </div>
                    </div>

                    <div class="how-reactions">
                        <span class="how-reaction-btn"><Icon Name="IconName.HeartFill" class="text-danger" /> @_event.Likes</span>
                        <span class="how-reaction-btn"><Icon Name="IconName.HandThumbsDownFill" /> @_event.Dislikes</span>
                        <span class="how-reaction-btn"><Icon Name="IconName.BookmarkFill" class="text-primary" /> @_event.SavedCount</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="h5 fw-bold mb-0"><Icon Name="IconName.ClockHistory" class="text-primary me-1" /> Occurrence Records (@_count)</h4>
    <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="ShowCreateRecordModal">
        <Icon Name="IconName.PlusLg" /> Log Occurrence
    </button>
</div>

@if (_count > 0)
{
    @foreach (var record in _recordsToDisplay)
    {
        <div class="how-record-card">
            <div class="d-flex flex-wrap justify-content-between align-items-center pb-2 mb-3 border-bottom gap-2">
                <div class="d-flex align-items-center gap-2 text-muted small">
                    <span class="badge bg-primary-subtle text-primary fw-semibold">Record #@record.Id</span>
                    <Icon Name="IconName.CalendarEvent" />
                    <span>@DurationFormatHelper.FormatLocalDateTime(record.CreatedAt, "MMM dd, yyyy HH:mm:ss")</span>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-dark rounded-pill px-3" @onclick="() => ShowUploadRecordImagesModal(record.Id)">
                        <Icon Name="IconName.Images" /> Upload Photos
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" @onclick="() => ShowUpdateRecordModal(record)">
                        <Icon Name="IconName.Pencil" /> Edit
                    </button>
                    <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" @onclick="() => DeleteRecord(record.Id)">
                        <Icon Name="IconName.Trash" /> Delete
                    </button>
                </div>
            </div>

            <div class="row g-3 align-items-center">
                <div class="col-md-6">
                    <p class="mb-3 fs-6">@record.Description</p>
                    <div class="how-reactions">
                        <span class="how-reaction-btn"><Icon Name="IconName.HeartFill" class="text-danger" /> @record.Likes</span>
                        <span class="how-reaction-btn"><Icon Name="IconName.HandThumbsDownFill" /> @record.Dislikes</span>
                    </div>
                </div>
                <div class="col-md-6">
                    @if (record.Images != null && record.Images.Any())
                    {
                        <div class="rounded-3 overflow-hidden bg-dark p-2">
                            <Carousel>
                                @for (int i = 0; i < record.Images.Count; i++)
                                {
                                    var recordImageThumbnail = record.Images[i].ThumbnailHash;
                                    <CarouselItem Active="@(i == 0)">
                                        <img src="@recordImageThumbnail" class="rounded d-block mx-auto" alt="Record Image" style="height: 220px; object-fit: contain;" />
                                    </CarouselItem>
                                }
                            </Carousel>
                        </div>
                    }
                    else
                    {
                        <div class="text-center p-4 bg-light rounded-3 border border-dashed text-muted small">
                            <Icon Name="IconName.Image" class="fs-4 d-block mb-1" />
                            No photos attached to this record
                        </div>
                    }
                </div>
            </div>
        </div>
    }

    <div class="d-flex justify-content-center mt-3">
        <Pagination ActivePageNumber="@_currentPageNumber" TotalPages="@_totalPage" PageChanged="OnPageChangedAsync" Alignment="Alignment.Center" />
    </div>
}
else
{
    <div class="how-empty-state">
        <div class="how-empty-icon"><Icon Name="IconName.JournalPlus" /></div>
        <h6 class="fw-bold">No occurrence records yet</h6>
        <p class="text-muted mb-3">Log occurrences, notes, and photos to build a chronological history for this event.</p>
        <button class="btn btn-primary rounded-pill px-4" @onclick="ShowCreateRecordModal">
            <Icon Name="IconName.PlusLg" /> Add First Record
        </button>
    </div>
}

@code {
    [Parameter]
    public int EventId { get; set; }

    [CascadingParameter]
    Task<AuthenticationState> AuthenticationState { get; set; }

    [CascadingParameter(Name = "ErrorComponent")]
    protected IErrorComponent ErrorComponent { get; set; }

    [Inject] ToastService ToastService { get; set; } = default!;

    private Modal _createEventModal = null!;
    private Modal _uploadImageModal = null!;
    private Modal _recordModal = null!;

    private int _selectedRecordIdForEdit;
    private int _selectedRecordIdForUpload;

    private int _count = 0;
    private EventItemPrivateModelDTO _event;
    private List<RecordItemPrivateModelDTO> _recordsToDisplay = new();
    private Dictionary<int, List<RecordItemPrivateModelDTO>> _loadedRecords = new();

    private int _currentPageNumber = 1;
    private int _pageSize = 5;
    private int _totalPage = 1;

    private Timer _timer;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (AuthenticationState is not null)
        {
            var authState = await AuthenticationState;
            var user = authState?.User;

            if (user?.Identity is not null && !user.Identity.IsAuthenticated)
            {
                NavigationManager.NavigateTo(Rout.Home.HomePublicPage);
                return;
            }
        }

        _timer = new Timer(1000);
        _timer.Elapsed += OnTimerElapsed;
        _timer.Start();

        InternalNotificationService.OnError += HandleError;

        await OnPageChangedAsync(_currentPageNumber);
    }

    private async void OnTimerElapsed(object sender, ElapsedEventArgs e)
    {
        if (_event is not null)
        {
            _event.Duration = DurationFormatHelper.CalculateElapsed(_event.CreatedAt);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ReloadEventAndRecords()
    {
        _loadedRecords.Clear();
        _recordsToDisplay.Clear();
        await OnPageChangedAsync(1);
    }

    private async Task OnPageChangedAsync(int pageNumber)
    {
        _currentPageNumber = pageNumber;

        await LoadEventDetail();
        await GetCurrentPage();
    }

    private async Task GetCurrentPage()
    {
        if (_loadedRecords.TryGetValue(_currentPageNumber, out var events))
        {
            _recordsToDisplay = events;
        }
        else
        {
            if (_currentPageNumber > _totalPage || _currentPageNumber < 1)
            {
                _currentPageNumber = _totalPage == 0 ? 1 : _totalPage;
            }
            await LoadRecords();
            if (_loadedRecords.TryGetValue(_currentPageNumber, out var loaded))
            {
                _recordsToDisplay = loaded;
            }
        }

        StateHasChanged();
    }

    private async Task LoadRecords()
    {
        var result = await RecordPrivateService.GetRecordsPagination(
            EventId,
            new GetRecordsPaginationPrivateRequestDTO
            {
                Page = _currentPageNumber,
                Size = _pageSize
            });

        foreach (var recordItem in result.Records)
        {
            foreach (var imageItem in recordItem.Images)
            {
                imageItem.MainHash = ImagePathHelper.GetPath(AppConfigurations.BackendUrl, imageItem.MainHash);
                imageItem.ThumbnailHash = ImagePathHelper.GetPath(AppConfigurations.BackendUrl, imageItem.ThumbnailHash);
            }
        }

        _count = result.Count;
        _totalPage = (int)Math.Ceiling((double)_count / _pageSize);

        _loadedRecords.TryAdd(_currentPageNumber, result.Records);
    }

    private async Task LoadEventDetail()
    {
        _event = await EventPrivateService.GetEventById(EventId);
        if (_event?.Image is null || _event.UserInfo?.Image is null)
        {
            return;
        }

        _event.Image.MainHash = ImagePathHelper.GetPath(AppConfigurations.BackendUrl, _event.Image.MainHash);
        _event.Image.ThumbnailHash = ImagePathHelper.GetPath(AppConfigurations.BackendUrl, _event.Image.ThumbnailHash);

        _event.UserInfo.Image.MainHash = ImagePathHelper.GetPath(AppConfigurations.BackendUrl, _event.UserInfo.Image.MainHash);
        _event.UserInfo.Image.ThumbnailHash = ImagePathHelper.GetPath(AppConfigurations.BackendUrl, _event.UserInfo.Image.ThumbnailHash);

        _event.Duration = DurationFormatHelper.CalculateElapsed(_event.CreatedAt);
        _event.AccessToggle = _event.Access == EventAccessType.Public;
        _event.StatusToggle = _event.Status == EventStatus.Active;
    }

    private async Task ShowUpdateEventModal()
    {
        var parameters = new Dictionary<string, object>
        {
            { "Name", _event.Name },
            { "OnClickCallback", EventCallback.Factory.Create<string>(this, UpdateEvent) }
        };
        await _createEventModal.ShowAsync<CreateUpdateEventModal>(title: "Update Event", parameters: parameters);
    }

    private async Task ShowUploadImageModal()
    {
        var parameters = new Dictionary<string, object>
        {
            { "EventId", _event.Id },
            { "Multiple", false },
            { "OnClickCallback", EventCallback.Factory.Create<InputFileChangeEventArgs>(this, UploadImage) }
        };
        await _uploadImageModal.ShowAsync<UploadImageModal>(title: "Upload Event Cover Image", parameters: parameters);
    }

    private async Task ShowCreateRecordModal()
    {
        var parameters = new Dictionary<string, object>
        {
            { "Description", string.Empty },
            { "OnClickCallback", EventCallback.Factory.Create<string>(this, CreateRecord) }
        };
        await _recordModal.ShowAsync<CreateUpdateRecordModal>(title: "Add New Occurrence Record", parameters: parameters);
    }

    private async Task CreateRecord(string description)
    {
        await _recordModal.HideAsync();
        var recordId = await RecordPrivateService.CreateRecord(EventId, description);
        if (recordId > 0)
        {
            ToastService.Notify(new(ToastType.Success, "Record added!"));
            await ReloadEventAndRecords();
        }
    }

    private async Task ShowUpdateRecordModal(RecordItemPrivateModelDTO record)
    {
        _selectedRecordIdForEdit = record.Id;
        var parameters = new Dictionary<string, object>
        {
            { "Description", record.Description },
            { "OnClickCallback", EventCallback.Factory.Create<string>(this, UpdateRecord) }
        };
        await _recordModal.ShowAsync<CreateUpdateRecordModal>(title: "Edit Record", parameters: parameters);
    }

    private async Task UpdateRecord(string description)
    {
        await _recordModal.HideAsync();
        var updated = await RecordPrivateService.UpdateRecord(EventId, _selectedRecordIdForEdit, description);
        if (updated)
        {
            ToastService.Notify(new(ToastType.Success, "Record updated!"));
            await ReloadEventAndRecords();
        }
    }

    private async Task DeleteRecord(int recordId)
    {
        var deleted = await RecordPrivateService.DeleteRecord(EventId, recordId);
        if (deleted)
        {
            ToastService.Notify(new(ToastType.Success, "Record deleted!"));
            await ReloadEventAndRecords();
        }
    }

    private async Task ShowUploadRecordImagesModal(int recordId)
    {
        _selectedRecordIdForUpload = recordId;
        var parameters = new Dictionary<string, object>
        {
            { "EventId", EventId },
            { "Multiple", true },
            { "OnClickCallback", EventCallback.Factory.Create<InputFileChangeEventArgs>(this, UploadRecordImages) }
        };
        await _uploadImageModal.ShowAsync<UploadImageModal>(title: "Upload Record Images (up to 5)", parameters: parameters);
    }

    private async Task UploadRecordImages(InputFileChangeEventArgs e)
    {
        var files = e.GetMultipleFiles(5);
        var result = await RecordPrivateService.UploadRecordImages(EventId, _selectedRecordIdForUpload, files);
        OnImageProcessing(result);
        await _uploadImageModal.HideAsync();
    }

    private async Task UpdateEvent(string name)
    {
        await _createEventModal.HideAsync();
        var result = await EventPrivateService.UpdateEvent(_event.Id, name);

        if (result)
        {
            _event.Name = name;
            ToastService.Notify(new(ToastType.Success, "Event updated!"));
        }
    }

    private async Task UploadImage(InputFileChangeEventArgs e)
    {
        var maxAllowedFiles = 1;

        foreach (var file in e.GetMultipleFiles(maxAllowedFiles))
        {
            var result = await EventPrivateService.UploadImage(EventId, file);
            OnImageProcessing(result);
        }
        await _uploadImageModal.HideAsync();
    }

    private async Task DeleteEvent()
    {
        var result = await EventPrivateService.DeleteEvent(_event.Id);

        if (result)
        {
            NavigationManager.NavigateTo(Rout.Dashboard.MainDashboard);
        }
    }

    private async Task OnAccessToggleChanged()
    {
        _event.AccessToggle = !_event.AccessToggle;
        _event.Access = _event.AccessToggle ? EventAccessType.Public : EventAccessType.Private;
        await EventPrivateService.UpdateEventAccessState(_event.Id, _event.AccessToggle);
    }

    private async Task OnStatusToggleChanged()
    {
        _event.StatusToggle = !_event.StatusToggle;
        _event.Status = _event.StatusToggle ? EventStatus.Active : EventStatus.Inactive;
        await EventPrivateService.UpdateEventActiveState(_event.Id, _event.StatusToggle);
    }

    private void HandleError(string message)
    {
        ErrorComponent?.ShowError("Error!", message);
    }

    private void OnImageProcessing(bool marker)
    {
        if (marker)
        {
            ToastService.Notify(new(ToastType.Success, $"Image queued for processing: {DateTime.Now:HH:mm:ss}"));
        }
        else
        {
            ToastService.Notify(new(ToastType.Warning, $"Image upload failed: {DateTime.Now:HH:mm:ss}"));
        }
    }

    public void Dispose()
    {
        InternalNotificationService.OnError -= HandleError;
        if (_timer is not null)
        {
            _timer.Elapsed -= OnTimerElapsed;
            _timer.Stop();
            _timer.Dispose();
        }
    }
}