@page "/authorized/dashboard"
@using HowClient.Infrastructure.DTO.Models
@using Microsoft.AspNetCore.Components.Authorization
@using System.Timers
@using HowClient.Configuration
@using HowClient.Infrastructure.DTO.Private.Event
@using HowClient.Infrastructure.Helpers
@using HowClient.Services.Private.Event
@using HowClient.Services.InternalNotification
@using HowClient.Infrastructure.Enums
@using Components
@using HowClient.Common.Routing
@using HowClient.Components.Modals

@inject IEventPrivateService EventPrivateService
@inject AppConfigurations AppConfigurations
@inject NavigationManager NavigationManager
@inject InternalNotificationService InternalNotificationService
@implements IDisposable

<PageTitle>My Dashboard — How Long Ago</PageTitle>

<Modal @ref="_modal" Size="ModalSize.Large"></Modal>

<div class="how-page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
    <div>
        <h1 class="h3 fw-bold">Events Workspace</h1>
        <p class="subtitle">Manage your personal events, collaborate on shared timelines, and review bookmarked milestones.</p>
    </div>
    <button class="btn btn-light fw-semibold rounded-pill px-4 d-flex align-items-center gap-2 shadow-sm" @onclick="ShowCreateEventModal">
        <Icon Name="IconName.PlusCircleFill" class="text-primary" /> Create New Event
    </button>
</div>

<div class="how-toolbar justify-content-between">
    <div class="d-flex flex-wrap align-items-center gap-2">
        <div class="btn-group" role="group" aria-label="Scope Filter">
            <button type="button"
                    class="btn btn-sm @(AccessFilter == ApiRequestAccessFilter.Own ? "btn-primary" : "btn-outline-secondary")"
                    @onclick="() => OnAccessFilterChanged(ApiRequestAccessFilter.Own)">
                <Icon Name="IconName.PersonFill" /> My Events
            </button>
            <button type="button"
                    class="btn btn-sm @(AccessFilter == ApiRequestAccessFilter.Shared ? "btn-primary" : "btn-outline-secondary")"
                    @onclick="() => OnAccessFilterChanged(ApiRequestAccessFilter.Shared)">
                <Icon Name="IconName.PeopleFill" /> Shared With Me
            </button>
            <button type="button"
                    class="btn btn-sm @(AccessFilter == ApiRequestAccessFilter.Saved ? "btn-primary" : "btn-outline-secondary")"
                    @onclick="() => OnAccessFilterChanged(ApiRequestAccessFilter.Saved)">
                <Icon Name="IconName.BookmarkHeartFill" /> Saved
            </button>
        </div>

        <Dropdown Color="DropdownColor.Light">
            <DropdownToggleButton Size="DropdownSize.Small" Class="border">
                Status: <strong>@Status</strong>
            </DropdownToggleButton>
            <DropdownMenu>
                <DropdownItem @onclick="() => OnStatusFilterChanged(EventStatus.None)" Type="DropdownItemType.Link">All Statuses</DropdownItem>
                <DropdownItem @onclick="() => OnStatusFilterChanged(EventStatus.Active)" Type="DropdownItemType.Link">Active Only</DropdownItem>
                <DropdownItem @onclick="() => OnStatusFilterChanged(EventStatus.Inactive)" Type="DropdownItemType.Link">Inactive Only</DropdownItem>
            </DropdownMenu>
        </Dropdown>

        <Dropdown Color="DropdownColor.Light">
            <DropdownToggleButton Size="DropdownSize.Small" Class="border">
                Visibility: <strong>@AccessType</strong>
            </DropdownToggleButton>
            <DropdownMenu>
                <DropdownItem @onclick="() => OnAccessTypeFilterChanged(EventAccessType.None)" Type="DropdownItemType.Link">All Visibility</DropdownItem>
                <DropdownItem @onclick="() => OnAccessTypeFilterChanged(EventAccessType.Public)" Type="DropdownItemType.Link">Public Only</DropdownItem>
                <DropdownItem @onclick="() => OnAccessTypeFilterChanged(EventAccessType.Private)" Type="DropdownItemType.Link">Private Only</DropdownItem>
            </DropdownMenu>
        </Dropdown>
    </div>

    <div class="d-flex align-items-center gap-2 flex-grow-1" style="max-width: 420px;">
        <div class="how-search-box">
            <i class="bi bi-search"></i>
            <InputText class="form-control form-control-sm" placeholder="Filter events by name..." @bind-Value="_searchQuery" />
        </div>
        <button class="btn btn-sm btn-primary px-3" @onclick="ReloadEvents" disabled="@_isLoading">
            Filter
        </button>
    </div>
</div>

@if (_isLoading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary mb-2" role="status"></div>
        <p class="text-muted mb-0">Loading workspace events...</p>
    </div>
}
else if (_count > 0)
{
    <div class="how-events-grid">
        @foreach (var item in _eventsToDisplay)
        {
            <div class="how-event-card">
                <div class="how-card-cover-wrap">
                    <img src="@item.Image.ThumbnailHash" class="how-card-cover" alt="@item.Name" />
                    <div class="how-card-badges">
                        <div class="d-flex gap-1">
                            <span class="how-pill-badge @(item.Access == EventAccessType.Public ? "how-pill-public" : "how-pill-private")">
                                <Icon Name="@(item.Access == EventAccessType.Public ? IconName.Globe : IconName.LockFill)" />
                                @item.Access
                            </span>
                            <span class="how-pill-badge @(item.Status == EventStatus.Active ? "how-pill-active" : "how-pill-inactive")">
                                @item.Status
                            </span>
                        </div>

                        @if (AccessFilter == ApiRequestAccessFilter.Own)
                        {
                            <button type="button"
                                    class="btn btn-sm btn-danger rounded-circle shadow-sm"
                                    title="Delete Event"
                                    @onclick="() => DeleteEvent(item.Id)">
                                <Icon Name="IconName.TrashFill" />
                            </button>
                        }
                    </div>
                </div>

                <div class="how-card-body">
                    <h5 class="how-card-title" title="@item.Name">@item.Name</h5>

                    <div class="how-timer-box">
                        <div class="how-timer-label">Elapsed Time</div>
                        <div class="how-timer-value">@DurationFormatHelper.FormatHumanReadable(item.Duration)</div>
                    </div>

                    @if (AccessFilter == ApiRequestAccessFilter.Own)
                    {
                        <div class="d-flex justify-content-between align-items-center bg-light rounded-3 px-3 py-2 border">
                            <Switch @onclick="async () => await OnAccessToggleChanged(item)"
                                    Value="item.AccessToggle"
                                    ValueExpression="() => item.AccessToggle"
                                    Label="Public" />
                            <Switch @onclick="async () => await OnStatusToggleChanged(item)"
                                    Value="item.StatusToggle"
                                    ValueExpression="() => item.StatusToggle"
                                    Label="Active" />
                        </div>
                    }

                    <div class="how-author-row">
                        <div class="how-author-info">
                            <img src="@item.UserInfo.Image.ThumbnailHash" class="how-avatar-sm" alt="Author" />
                            <div>
                                <div class="how-author-name">
                                    @(string.IsNullOrWhiteSpace($"{item.UserInfo.FirstName} {item.UserInfo.LastName}")
                                        ? "Owner"
                                        : $"{item.UserInfo.FirstName} {item.UserInfo.LastName}")
                                </div>
                                <div class="how-created-date">Created @item.CreatedAt.ToString("MMM dd, yyyy HH:mm")</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="how-action-bar">
                    <div class="how-reactions">
                        <span class="how-reaction-btn" title="Likes">
                            <Icon Name="IconName.HeartFill" class="text-danger" /> @item.Likes
                        </span>
                        <span class="how-reaction-btn" title="Dislikes">
                            <Icon Name="IconName.HandThumbsDownFill" /> @item.Dislikes
                        </span>
                        <span class="how-reaction-btn" title="Saved Count">
                            <Icon Name="IconName.BookmarkFill" class="text-primary" /> @item.SavedCount
                        </span>
                    </div>
                    <button class="btn btn-sm btn-primary rounded-pill px-3" @onclick="() => NavigateToEventInfo(item.Id)">
                        Manage <Icon Name="IconName.ArrowRight" />
                    </button>
                </div>
            </div>
        }
    </div>

    <div class="d-flex justify-content-center mt-3">
        <Pagination ActivePageNumber="@_currentPageNumber" TotalPages="@_totalPage" PageChanged="OnPageChangedAsync" Alignment="Alignment.Center" />
    </div>
}
else
{
    <div class="how-empty-state">
        <div class="how-empty-icon"><Icon Name="IconName.FolderPlus" /></div>
        <h5 class="fw-bold">No events in "@AccessFilter"</h5>
        <p class="text-muted mb-3">
            @(AccessFilter == ApiRequestAccessFilter.Own
                ? "Start tracking your first event or milestone right now."
                : "No shared or saved events match your current filters.")
        </p>
        <button class="btn btn-primary rounded-pill px-4" @onclick="ShowCreateEventModal">
            <Icon Name="IconName.PlusLg" /> Create New Event
        </button>
    </div>
}

@code {
    [CascadingParameter]
    Task<AuthenticationState> AuthenticationState { get; set; }

    [CascadingParameter(Name = "ErrorComponent")]
    protected IErrorComponent ErrorComponent { get; set; }

    private Modal _modal = null!;

    private EventStatus Status { get; set; } = EventStatus.None;
    private EventAccessType AccessType { get; set; } = EventAccessType.None;
    private ApiRequestAccessFilter AccessFilter { get; set; } = ApiRequestAccessFilter.Own;

    private int _count = 0;
    private bool _isLoading = true;
    private List<EventItemPrivateModelDTO> _eventsToDisplay = new();
    private Dictionary<int, List<EventItemPrivateModelDTO>> _loadedEvents = new();

    private int _currentPageNumber = 1;
    private readonly int _pageSize = 6;
    private int _totalPage = 1;
    private string _searchQuery = string.Empty;

    private Timer _timer;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (AuthenticationState is not null)
        {
            var authState = await AuthenticationState;
            var user = authState?.User;

            if (user?.Identity is not null && !user.Identity.IsAuthenticated)
            {
                NavigationManager.NavigateTo(Rout.Home.HomePublicPage);
                return;
            }
        }

        _timer = new Timer(1000);
        _timer.Elapsed += OnTimerElapsed;
        _timer.Start();

        InternalNotificationService.OnError += HandleError;

        await OnPageChangedAsync(_currentPageNumber);
    }

    private async void OnTimerElapsed(object sender, ElapsedEventArgs e)
    {
        foreach (var eventItem in _eventsToDisplay)
        {
            eventItem.Duration = DateTime.Now - eventItem.CreatedAt;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task OnAccessFilterChanged(ApiRequestAccessFilter filter)
    {
        AccessFilter = filter;
        await ReloadEvents();
    }

    private async Task OnStatusFilterChanged(EventStatus status)
    {
        Status = status;
        await ReloadEvents();
    }

    private async Task OnAccessTypeFilterChanged(EventAccessType accessType)
    {
        AccessType = accessType;
        await ReloadEvents();
    }

    private async Task ReloadEvents()
    {
        _currentPageNumber = 1;
        _eventsToDisplay.Clear();
        _loadedEvents.Clear();
        await GetCurrentPage();
    }

    private async Task OnPageChangedAsync(int pageNumber)
    {
        _currentPageNumber = pageNumber;
        await GetCurrentPage();
    }

    private async Task GetCurrentPage()
    {
        _isLoading = true;
        StateHasChanged();

        if (_loadedEvents.TryGetValue(_currentPageNumber, out var events))
        {
            _eventsToDisplay = events;
        }
        else
        {
            if (_currentPageNumber > _totalPage || _currentPageNumber < 1)
            {
                _currentPageNumber = _totalPage == 0 ? 1 : _totalPage;
            }

            await LoadEvents();
            if (_loadedEvents.TryGetValue(_currentPageNumber, out var loaded))
            {
                _eventsToDisplay = loaded;
            }
        }

        _isLoading = false;
        StateHasChanged();
    }

    private async Task LoadEvents()
    {
        var result = await EventPrivateService.GetEventsPagination(
            new GetEventsPaginationPrivateRequestDTO
            {
                Page = _currentPageNumber,
                Size = _pageSize,
                Search = _searchQuery,
                Status = Status,
                Access = AccessType
            },
            AccessFilter);

        foreach (var eventItem in result.Events)
        {
            eventItem.Image.MainHash = ImagePathHelper.GetPath(AppConfigurations.BackendUrl, eventItem.Image.MainHash);
            eventItem.Image.ThumbnailHash = ImagePathHelper.GetPath(AppConfigurations.BackendUrl, eventItem.Image.ThumbnailHash);

            eventItem.UserInfo.Image.MainHash = ImagePathHelper.GetPath(AppConfigurations.BackendUrl, eventItem.UserInfo.Image.MainHash);
            eventItem.UserInfo.Image.ThumbnailHash = ImagePathHelper.GetPath(AppConfigurations.BackendUrl, eventItem.UserInfo.Image.ThumbnailHash);

            eventItem.Duration = DateTime.Now - eventItem.CreatedAt;
            eventItem.AccessToggle = eventItem.Access == EventAccessType.Public;
            eventItem.StatusToggle = eventItem.Status == EventStatus.Active;
        }

        _count = result.Count;
        _totalPage = (int)Math.Ceiling((double)_count / _pageSize);

        _loadedEvents.TryAdd(_currentPageNumber, result.Events);
    }

    private async Task ShowCreateEventModal()
    {
        var parameters = new Dictionary<string, object>
        {
            { "OnClickCallback", EventCallback.Factory.Create<string>(this, CreateEvent) }
        };
        await _modal.ShowAsync<CreateUpdateEventModal>(title: "Create New Event", parameters: parameters);
    }

    private async Task CreateEvent(string name)
    {
        await _modal.HideAsync();
        var result = await EventPrivateService.CreateEvent(name);

        if (result > 0)
        {
            await ReloadEvents();
        }
    }

    private async Task DeleteEvent(int id)
    {
        var result = await EventPrivateService.DeleteEvent(id);

        if (result)
        {
            await ReloadEvents();
        }
    }

    private void NavigateToEventInfo(int eventId)
    {
        if (AccessFilter == ApiRequestAccessFilter.Saved)
        {
            NavigationManager.NavigateTo(Rout.Event.EventPrivatePage(eventId));
            return;
        }

        NavigationManager.NavigateTo(Rout.Dashboard.EventPrivatePage(eventId));
    }

    private async Task OnAccessToggleChanged(EventItemPrivateModelDTO eventItemPrivate)
    {
        eventItemPrivate.AccessToggle = !eventItemPrivate.AccessToggle;
        eventItemPrivate.Access = eventItemPrivate.AccessToggle ? EventAccessType.Public : EventAccessType.Private;
        await EventPrivateService.UpdateEventAccessState(eventItemPrivate.Id, eventItemPrivate.AccessToggle);
    }

    private async Task OnStatusToggleChanged(EventItemPrivateModelDTO eventItemPrivate)
    {
        eventItemPrivate.StatusToggle = !eventItemPrivate.StatusToggle;
        eventItemPrivate.Status = eventItemPrivate.StatusToggle ? EventStatus.Active : EventStatus.Inactive;
        await EventPrivateService.UpdateEventActiveState(eventItemPrivate.Id, eventItemPrivate.StatusToggle);
    }

    private void HandleError(string message)
    {
        ErrorComponent?.ShowError("Error!", message);
    }

    public void Dispose()
    {
        InternalNotificationService.OnError -= HandleError;
        if (_timer is not null)
        {
            _timer.Elapsed -= OnTimerElapsed;
            _timer.Stop();
            _timer.Dispose();
        }
    }
}