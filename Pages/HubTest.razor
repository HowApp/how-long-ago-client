@page "/hub-test"
@using HowClient.Configuration
@using Microsoft.AspNetCore.SignalR.Client
@inject AppConfigurations AppConfigurations
@implements IAsyncDisposable

<PageTitle>Realtime Hub Monitor — How Long Ago</PageTitle>

<div class="how-page-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
    <div>
        <h1 class="h3 fw-bold">Realtime Image Processing Hub</h1>
        <p class="subtitle">Monitor live SignalR WebSocket notifications from the background image processing worker.</p>
    </div>
    <div>
        <button class="btn btn-light fw-semibold rounded-pill px-4" @onclick="StartConnection" disabled="@(_isConnected)">
            <Icon Name="IconName.BroadcastPin" class="@(_isConnected ? "text-success" : "text-primary")" />
            @(_isConnected ? "Connected" : "Connect to Hub")
        </button>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <h5 class="fw-bold mb-3">Incoming Hub Events (@messages.Count)</h5>
        @if (messages.Any())
        {
            <ul class="list-group rounded-3">
                @foreach (var message in messages)
                {
                    <li class="list-group-item font-monospace small">@message</li>
                }
            </ul>
        }
        else
        {
            <div class="how-empty-state py-4 my-0">
                <div class="how-empty-icon fs-2"><Icon Name="IconName.Broadcast" /></div>
                <p class="text-muted mb-0">No realtime messages received yet. Connect to the hub and upload an image to see live notifications.</p>
            </div>
        }
    </div>
</div>

@code {
    private HubConnection hubConnection;
    private List<string> messages = new();
    private bool _isConnected => hubConnection?.State == HubConnectionState.Connected;

    private async Task StartConnection()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }

        var baseUrl = AppConfigurations.BackendUrl?.TrimEnd('/') ?? "https://localhost:7060";
        hubConnection = new HubConnectionBuilder()
            .WithUrl($"{baseUrl}/hubs/fileProcessing")
            .WithAutomaticReconnect()
            .Build();

        hubConnection.On<string>("ReceiveMessage", (message) =>
        {
            messages.Add($"[{DateTime.Now:HH:mm:ss}] {message}");
            InvokeAsync(StateHasChanged);
        });

        await hubConnection.StartAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }
}