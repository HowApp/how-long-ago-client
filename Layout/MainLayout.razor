@using Microsoft.AspNetCore.Components.Authorization
@using Components
@using HowClient.Common.Routing
@using Microsoft.AspNetCore.Components.WebAssembly.Authentication

@inherits LayoutComponentBase
@inject NavigationManager NavigationManager
@implements IErrorComponent

<div class="bb-page">
    <Sidebar @ref="_sidebar"
             IconName="IconName.ClockHistory"
             Title="How Long Ago"
             BadgeText="v2.0"
             DataProvider="SidebarDataProvider" />

    <Offcanvas @ref="_offcanvas" />

    <main>
        <div class="how-topbar px-4 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <NavLink href="/" class="d-flex align-items-center gap-2 text-decoration-none">
                    <img src="logo.webp" class="project-icon" alt="How Long Ago Logo" />
                    <span class="fw-bold text-dark d-none d-sm-inline" style="font-size: 1.05rem;">How Long Ago</span>
                </NavLink>
            </div>

            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-2 rounded-pill px-3" @onclick="@ShowOffCanvasContent">
                    <Icon Name="IconName.BellFill" />
                    <span class="d-none d-md-inline">Alerts</span>
                    @if (_errors.Count > 0)
                    {
                        <Badge Color="BadgeColor.Danger" IndicatorType="BadgeIndicatorType.RoundedPill">@_errors.Count</Badge>
                    }
                    else
                    {
                        <Badge Color="BadgeColor.Secondary" IndicatorType="BadgeIndicatorType.RoundedPill">0</Badge>
                    }
                </button>

                <AuthorizeView>
                    <Authorized>
                        <NavLink href="@Rout.Dashboard.ProfilePage" class="btn btn-sm btn-light border rounded-pill px-3 d-flex align-items-center gap-2">
                            <Icon Name="IconName.PersonCircle" />
                            <span class="d-none d-md-inline">@(context.User.Identity?.Name ?? "Profile")</span>
                        </NavLink>
                        <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" @onclick="@LogoutClick">
                            <Icon Name="IconName.BoxArrowRight" /> <span class="d-none d-sm-inline">Logout</span>
                        </button>
                    </Authorized>
                    <NotAuthorized>
                        <button type="button" class="btn btn-sm btn-primary rounded-pill px-3" @onclick="@LoginClick">
                            <Icon Name="IconName.BoxArrowInRight" /> Sign In
                        </button>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <article class="content px-4 pb-5">
            <CascadingValue Value="this" Name="ErrorComponent">
                <div class="py-2">@Body</div>
            </CascadingValue>
        </article>
    </main>
</div>

<Toasts class="p-3" AutoHide="true" Delay="4000" Placement="ToastsPlacement.TopRight" />

@code {
    [CascadingParameter]
    Task<AuthenticationState>? AuthenticationState { get; set; }

    bool _isAuthorized;

    private Sidebar _sidebar;
    IEnumerable<NavItem> _navItems;

    private Offcanvas _offcanvas;

    private Dictionary<long, (string title, string message)> _errors = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (AuthenticationState is not null)
        {
            var user = (await AuthenticationState).User;
            _isAuthorized = user.Identity != null && user.Identity.IsAuthenticated;
        }
    }

    private async Task<SidebarDataProviderResult> SidebarDataProvider(SidebarDataProviderRequest request)
    {
        if (AuthenticationState is not null)
        {
            var user = (await AuthenticationState).User;
            _isAuthorized = user.Identity != null && user.Identity.IsAuthenticated;
        }

        _navItems = GetNavItems();

        return await Task.FromResult(request.ApplyTo(_navItems));
    }

    private IEnumerable<NavItem> GetNavItems()
    {
        var items = new List<NavItem>
        {
            new NavItem { Id = "1", Href = _isAuthorized ? Rout.Home.HomePrivatePage : Rout.Home.HomePublicPage, IconName = IconName.CompassFill, Text = "Explore Feed", Match = NavLinkMatch.All }
        };

        if (_isAuthorized)
        {
            items.Add(new NavItem { Id = "2", Href = Rout.Dashboard.MainDashboard, IconName = IconName.Grid1X2Fill, Text = "My Dashboard" });
            items.Add(new NavItem { Id = "3", Href = Rout.Dashboard.ProfilePage, IconName = IconName.PersonBadgeFill, Text = "Profile & Sharing" });
            items.Add(new NavItem { Id = "4", Href = "/hub-test", IconName = IconName.BroadcastPin, Text = "Realtime Hub" });
        }

        _navItems = items;
        return _navItems;
    }

    void LogoutClick()
    {
        NavigationManager.NavigateToLogout(Rout.LogoutIdentity);
    }

    void LoginClick()
    {
        NavigationManager.NavigateToLogin(Rout.LoginIdentity);
    }

    public void ShowError(string title, string message)
    {
        _errors.Add(DateTime.UtcNow.ToBinary(), (title, message));
        StateHasChanged();
    }

    private async Task ShowOffCanvasContent()
    {
        var parameters = new Dictionary<string, object>
        {
            { "ErrorsToDisplay", _errors.Select(x => (x.Key, x.Value.title, x.Value.message)) },
            { "OnClickCallback", EventCallback.Factory.Create<long>(this, RemoveErrorItem) }
        };

        await _offcanvas.ShowAsync<ErrorItemOffCanvasComponent>(title: "Notifications & Alerts", parameters: parameters);
    }

    public void RemoveErrorItem(long errorId)
    {
        _errors.Remove(errorId);
        StateHasChanged();
    }
}