@using System.ComponentModel.DataAnnotations

<EditForm EditContext="@_editContext" OnValidSubmit="HandleOnValidSubmit">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label fw-semibold">Occurrence Notes / Description <span class="text-danger">*</span></label>
        <TextAreaInput @bind-Value="@_model.Description" Rows="4" Placeholder="Describe what happened at this occurrence..." />
        <ValidationMessage For="@(() => _model.Description)" />
    </div>

    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
        <Button Type="ButtonType.Button" Color="ButtonColor.Light" Class="border rounded-pill px-3" @onclick="ResetForm">Clear</Button>
        <Button Type="ButtonType.Submit" Color="ButtonColor.Primary" Class="rounded-pill px-4">
            <Icon Name="IconName.Check2" /> Save Record
        </Button>
    </div>
</EditForm>

@code {
    private RecordFormModel _model;
    private EditContext _editContext;

    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> OnClickCallback { get; set; }

    public async Task HandleOnValidSubmit()
    {
        if (_editContext.Validate())
        {
            await OnClickCallback.InvokeAsync(_model.Description);
        }
    }

    private void ResetForm()
    {
        _model.Description = string.Empty;
        _editContext = new EditContext(_model);
    }

    protected override void OnInitialized()
    {
        _model = new RecordFormModel
        {
            Description = Description
        };
        _editContext = new EditContext(_model);
        base.OnInitialized();
    }

    private class RecordFormModel
    {
        [Required(AllowEmptyStrings = false, ErrorMessage = "Description is required.")]
        [StringLength(2048, ErrorMessage = "Description must be at most 2048 characters.")]
        public string Description { get; set; }
    }
}
