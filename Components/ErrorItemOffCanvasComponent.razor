@if (ErrorsToDisplay != null && ErrorsToDisplay.Any())
{
    <div class="d-flex flex-column gap-2">
        @foreach (var item in ErrorsToDisplay)
        {
            <div class="alert alert-danger d-flex justify-content-between align-items-start mb-0 shadow-sm border-0">
                <div class="flex-grow-1 pe-2">
                    <div class="fw-bold mb-1 d-flex align-items-center gap-1">
                        <Icon Name="IconName.ExclamationTriangleFill" />
                        <span>@item.title</span>
                    </div>
                    <div class="small">@item.message</div>
                </div>
                <button type="button" class="btn-close" aria-label="Close" @onclick="() => TriggerCallback(item.id)"></button>
            </div>
        }
    </div>
}
else
{
    <div class="text-center text-muted py-5">
        <div class="fs-2 mb-2"><Icon Name="IconName.CheckCircle" /></div>
        <p class="mb-0">No active alerts or errors.</p>
    </div>
}

@code {
    [Parameter]
    public IEnumerable<(long id, string title, string message)> ErrorsToDisplay { get; set; }

    [Parameter]
    public EventCallback<long> OnClickCallback { get; set; }

    private async Task TriggerCallback(long id)
    {
        await OnClickCallback.InvokeAsync(id);
    }
}